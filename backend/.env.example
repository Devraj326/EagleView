# --- App ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440
APP_DB_URL=sqlite:///./app_metadata.db
CORS_ORIGINS=http://localhost:5173

# --- Google Sign-In ---
# OAuth 2.0 Client ID from https://console.cloud.google.com/apis/credentials
# Used to verify the ID token the frontend gets from Google Identity Services.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# --- Gemini ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Snowflake ---
SNOWFLAKE_ACCOUNT=xy12345.ap-south-1
SNOWFLAKE_USER=your-user
# Use exactly one of the two auth methods below
SNOWFLAKE_PASSWORD=
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_ROLE=SYSADMIN
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=ANALYTICS_DB

# Upload limits
MAX_UPLOAD_MB=25
