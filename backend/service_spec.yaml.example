# Snowpark Container Services spec for the EgleView FastAPI backend.
# Copy to service_spec.yaml (gitignored) and fill in real values from backend/.env
# before running:
#   CREATE SERVICE EGLE_VIEW.PUBLIC.EGLEVIEW_BACKEND
#     IN COMPUTE POOL EGLEVIEW_BACKEND_POOL
#     FROM SPECIFICATION_FILE = 'service_spec.yaml';
spec:
  containers:
    - name: egleview-backend
      image: /egle_view/public/egleview_repo/egleview-backend:latest
      env:
        JWT_SECRET: "replace-with-a-long-random-string"
        JWT_EXPIRE_MINUTES: "1440"
        APP_DB_URL: "sqlite:///./app_metadata.db"
        CORS_ORIGINS: "https://your-frontend-url"
        GOOGLE_CLIENT_ID: "your-google-oauth-client-id.apps.googleusercontent.com"
        SNOWFLAKE_ACCOUNT: "your-account"
        SNOWFLAKE_USER: "your-user"
        SNOWFLAKE_PASSWORD: "your-password"
        SNOWFLAKE_ROLE: "ACCOUNTADMIN"
        SNOWFLAKE_WAREHOUSE: "COMPUTE_WH"
        SNOWFLAKE_DATABASE: "EGLE_VIEW"
        MAX_UPLOAD_MB: "25"
      resources:
        requests:
          cpu: "0.5"
          memory: "1Gi"
        limits:
          cpu: "1"
          memory: "2Gi"
  endpoints:
    - name: api
      port: 8001
      public: true
